{entity
	(include "/properties/tank_2km.ext")
	(include "/properties/shadow/tank.inc" scale(1.0))
	(include "/properties/selection/vehicle.inc" scale(1.2))
	{props  "light" "tank2" "turret2" "turret_rotator" "turret_2nd"}

   {extender "light"
      {lightfx "light_boat"}
      {breakfx "glass_hit"}
      {lamp "1"}
   }

   {extender "light"
      {lightfx "light_boat"}
      {breakfx "glass_hit"}
      {lamp "2"}
   }

   {Volume "lamp1"
      {thickness 2}
   }
   {Volume "lamp2"
      {thickness 2}
   }
	
	
	{volume "body1"
		{tags "body"}
		{component "body"}
		{thickness 10
			{front	20}
			{bottom 8}
		}
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
		{thickness 10
			{front	 20}
			{bottom 8}
		}
	}
	{volume "body3"
		{tags "body"}
		{component "body"}
		{thickness 15
			{front	 25}
			{top 25}
		}
	}
	{volume "turret"
		{tags "turret"}
		{component "turret"}
		{thickness 12
			{front	 15}
			{top 10}
		}		
	}
	{volume "turret2"
		{tags "turret2"}
		{component "turret2"}
		{thickness 12
			{front	 15}
			{top 10}
		}		
	}


	("crew_3_human_7TP")

	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_LowArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))

	{Weaponry
		{place "mgun"
			{DefaultWeapon "ckmbrowning"}
			{Mounted}
			{weapon {ammo "ammo mgun" 300}}
		}
		{place "mgun2"
			{foresight "foresight2"}
			{DefaultWeapon "ckmbrowning_2"}
			{Mounted}
			{weapon {ammo "ammo mgun" 300}}
		}
	}
	{extender "inventory"
		{box
			{item  "ammo mgun" 1200}
		}
	}
	
	{mass 10250}
	{Chassis
		{track_size 0.6 0.7}
		{Locomotion ("locomotion")}
	}
	{Extension "7TP.mdl"}
}
