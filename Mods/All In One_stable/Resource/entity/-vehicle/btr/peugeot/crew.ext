;SDL

{boarder
	{anm "driver"
		{forward	{begin	"board_gaz-m_driver"} {end "seat_driver_car"} {base "doorleft"}}
		{reverse 	{end	"board_gaz-m_driver" -1} {base "doorleft" -1}}
	}
	{anm "commander"
		{forward	{begin	"board_gaz-m_driver"} {end "seat_passenger"} {base "doorleft"}}
		{reverse 	{end	"board_gaz-m_driver" -1} {base "doorleft" -1}}
	}
	{anm "gunner"
		{forward	{begin	"board_SdKfz251-1"} {end "seat_gunner_stand"}}
		{reverse 	{end	"emit_body"}}
	}
	{anm "seat1"
		{forward	{begin	"board_SdKfz251-1"} {end "squat_from_stand_empty"}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "seat2"
		{forward	{begin	"board_SdKfz251-1"} {end "squat_from_stand_empty"}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "seat3"
		{forward	{begin	"board_SdKfz251-1"} {end "squat_from_stand_empty"}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "seat4"
		{forward	{begin	"board_SdKfz251-1"} {end "squat_from_stand_empty"}}
		{reverse 	{end	"emit_tank_1"}}
	}
	{anm "seat5"
		{forward	{begin	"board_SdKfz251-1"} {end "squat_from_stand_empty"}}
		{reverse 	{end	"emit_tank_1"}}
	}
}

{Placer
	{place "driver"		{LinkBone "driver"}	{Group "crew"}	{turnoff {sensor} {shadow}} {visor "driver"}}
	{place "commander"	{LinkBone "commander"}	{Group "crew"}	{turnoff {sensor} {shadow}} {visor "driver"}}
	{place "gunner"		{LinkBone "gunner"}	{Group "crew"}	{turnoff {sensor} {shadow}} {worker charger} {visor "main"}}
	{place "seat1"		{LinkBone "seat01"}	{Group "passengers"}	{turnoff {sensor} {shadow}} {visor "crew"}}
	{place "seat2"		{LinkBone "seat02"}	{Group "passengers"}	{turnoff {sensor} {shadow}} {visor "crew"}}
	{place "seat3"		{LinkBone "seat03"}	{Group "passengers"}	{turnoff {sensor} {shadow}} {visor "crew"}}
	{place "seat4"		{LinkBone "seat04"}	{Group "passengers"}	{turnoff {sensor} {shadow}} {visor "crew"}}
	{place "seat5"		{LinkBone "seat05"}	{Group "passengers"}	{turnoff {sensor} {shadow}} {visor "crew"}}
}

(define "crew_human"
	{boarder
		{door "%door"}
		{link "%door" "%place" {anm "%place"} {forward putoff} {reverse puton}}
	}
)


("crew_human" place(driver)	door(emit3))
("crew_human" place(commander)	door(emit3))
("crew_human" place(gunner)	door(emit2))
("crew_human" place(seat1)	door(emit1))
("crew_human" place(seat2)	door(emit1))
("crew_human" place(seat3)	door(emit1))
("crew_human" place(seat4)	door(emit2))
("crew_human" place(seat5)	door(emit2))
