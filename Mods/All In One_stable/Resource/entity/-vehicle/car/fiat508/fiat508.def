{game_entity
	(include "/properties/car.ext")
	(include "/properties/shadow/tank.inc"  scale(0.9))
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{props "vehicle" "car" "wheeled" "with_doors"}
	{props "emit_on_attack"}
	{PatherId "vehicle.small"}

	("crew_2_human")

	{boarder
		{anm "driver"
			{forward	{begin	"board_gaz-m_driver"} {end "seat_driver_car"} {base "doorleft"}}
			{reverse 	{end	"board_gaz-m_driver" -1} {base "doorleft" -1}}
		}
	}

	{boarder
		{anm "commander"
			{forward	{begin	"board_gaz-m"} {end "seat_passenger"} {base "doorright"}}
			{reverse 	{end	"board_gaz-m" -1} {base "doorright" -1}}
		}
	}

	("passenger_invisible" place(seat1)	bone(seat01)	door(emit4) animation(passenger))
	("passenger_invisible" place(seat2)	bone(seat02)	door(emit4) animation(passenger))	

	{boarder
		{anm "passenger"
			{forward	{begin	"board_gaz-m"}}
			{reverse 	{end	"board_gaz-m" -1}}
		}
	}

	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")

	{mass 1500}
	{Chassis
		{Locomotion ("locomotion")
			{MaxSpeed 	    35} ; максимальная скорость, kmph
			{StartTime 		 6} ; время разгона до макс. скорости с 0, seconds
			{BrakeTime 		1} ; время торможения с макс. скорости до 0, seconds
			{StopTime		 1} ; время остановки после отключения двигателя с макс. скорости до 0, seconds
			{TurnRadius     5} ; мин. радиус разворота, meter
			{TurnTime		5} ; время на разворот на 360 градусов при макс. скорости разворота, seconds
			{TurnStart		 2}	; время разгона до макс. угловой скорости с 0, seconds
			{TurnStop	   0.5}	; время остановки с макс. угловой скорости до 0, seconds
			{Gears 0.2 0.3 0.5 0.7 1.0} ; передаточные коэф-ты коробки передач
			{RearGears 0.2 0.5} ; передаточные коэф-ты коробки передач
		}
	}
	{Extension "fiat508.mdl"}
}
