{car
	(include "/properties/car.ext")
	(include "/properties/shadow/tank.inc"  scale(0.8))
	(include "/properties/selection/vehicle.inc"  scale(1.1))
	{props "vehicle" "car" "wheeled" "with_doors"}
	{props "emit_on_attack"}
	{PatherId "vehicle.small"}
	
	("wheel" args "wheelright1")
	("wheel" args "wheelleft1")
	("wheel" args "wheelright2")
	("wheel" args "wheelleft2")	
	
	("crew_2_human")

	("board_animation"
		place(driver)
		board_begin(board_willis_driver)
		board_end(seat_Willis_driver)
		base(doorleft)
	)
	("board_animation"
		place(commander)
		board_begin(board_willis)
		board_end(seat_Willis_passenger)
		base(doorright)
	)
	{boarder
		{anm "gunner"
			{forward	{begin	"board_LowTank_stand"} {end "seat_gunner_stand"}}
			{reverse 	{end	"emit_tank_1_hold" 1}}
		}
	}
	
	("crew_human"		place(gunner)	bone(gunner)	door(emit3)		animation(gunner))

	{placer
		{place "driver"		{group "crew"}}
		{place "commander"	{group "crew"}}
		{place "gunner"		{group "crew"} {worker charger}}
	}
	
	{Weaponry
		{place "mgun"
			{LinkBone "mgun"}
			{LinkAnimation "off"}
			{DefaultWeapon "hotchkiss"}
			{Mounted}
			{weapon {ammo "ammo mgun" 300}}
		}
	}
	{extender "inventory"
		{weapon "mgun"
			{mask "weapon mgun"}
		}
		{Box
			{size 5 6}
			{item  "ammo mgun" 600}
		}
	}
	{mass 15000}
	{Chassis
		{Locomotion ("locomotion")
			{Maxspeed 50}
			{StartTime	3}		; ˘ŕĄ¬ď ŕ §Ł®­  ¤® ¬ Şá. áŞ®ŕ®áâ¨ á 0, seconds
		}
	}	
	
	{Volume "body"
		{tags "body"}
		{component "body"}
		{thickness 7}   
	}
	{Volume "engine"
		{tags "engine"}
		{component "engine"}
		{thickness 8}  	
	}

	
  {sensor
    {visor "main"
      {vision "wmb-main"}
      {bone "visor1"}
    }
    {Visor "driver"
      {vision "wmb-driver"}
      {bone "visor2"}
    }
  }	
	
	{Extension "v15t.mdl"}	
}
