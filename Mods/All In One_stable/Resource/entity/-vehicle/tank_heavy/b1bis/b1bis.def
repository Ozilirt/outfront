			{top	30}
		}  	
	}
	
	("crew_4_human")	
	
	{boarder
		{anm "left"
			{forward	{begin	"board_tank_left"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_tank_right"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
	}	
	
	{Weaponry
		
		{place "gun"
			{Rotate}
			{DefaultWeapon "47mm_sa35"}
			{Mounted}
			{weapon {ammo "ammo bullet47 ap" 1}}
            	}
	     	{place "mgun"
			{DefaultWeapon "reibel"}
			{Mounted}
			{weapon {ammo "ammo mgun" 150}}
		}
		{place "gun2"
			{Rotate}
			{DefaultWeapon "75mm_sa35"}
			{Mounted}
			{weapon {ammo "ammo bullet75 fg" 1}}
		}
	}
	{extender "inventory"
		{weapon "gun2" {fixed}}
		{weapon "gun" {fixed}}
		{weapon "mgun" {fixed}{mask "weapon mgun"}}
		{box
			{item "ammo mgun" 600}
			{item "ammo bullet47 ap" 42}
			{item "ammo bullet47 fg" 78}
			{item "ammo bullet75 fg" 30}
		}
	}	
	
