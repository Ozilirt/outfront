{entity
	(include "/properties/tank_multiturret.ext")
	(include "/properties/shadow/tank.inc"  scale(1.2))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "heavy" "turret_rotator" "huge" "turret_2nd" "turret2" "mgun2" "mgun3" "mgun4"}
	
	{TexMods
		{"1" "1"}
		{"2ka" "2"}
	}	
	
	{Volume "Gun"
		{thickness 25}
	}
	{volume "body"
		{component "body"}
		{tags "body"}
		{thickness 30
			{front  45}
			{rear 22}
		}   
	}
	{volume "body2"
		{component "body"}
		{tags "body"}
		{thickness 30
			{front  45}
			{rear 22}
		}
	}
	{volume "body3"
		{component "body"}
		{tags "body"}
		{thickness 30
			{front  45}
			{rear 22}
		}
	}			
	
	{volume "turret"
		{component "turret"}
		{tags "turret"}
		{thickness 30
			{front  45}
		}
	}			
	{volume "turret2"
		{component "turret2"}
		{tags "turret2"}
		{thickness 22
			{front  30}
		}
	}				
	
	("crew_4_human")
	
	{Weaponry
		{place "gun"
			{Rotate}
			{DefaultWeapon "47mm_sa35"}
			{Mounted}
			{weapon {ammo "ammo bullet47 ap" 1}}
    }
	  {place "mgun"
			;{LinkAnimation "off"}
			;{LinkBone "mgun_rot_y"}
			{DefaultWeapon "hotchkiss"}			
			{Mounted}
			{weapon {ammo "ammo mgun" 150}}
		}
	  {place "mgun2"
	    {foresight "foresight2"}
			;{LinkBone "mgun4_rot"}
			;{LinkAnimation "off"}
			{DefaultWeapon "hotchkiss"}			
			{Mounted}
			{weapon {ammo "ammo mgun" 150}}
		}
	  {place "mgun3"
	    {foresight "foresight6"}
			;{LinkBone "mgun2_rot_y"}
			;{LinkAnimation "off"}
			{DefaultWeapon "hotchkiss"}			
			{Mounted}
			{weapon {ammo "ammo mgun" 150}}
		}				  
	  {place "mgun4"
	    {foresight "foresight4"}
			;{LinkBone "mgun3_rot_y"}
			;{LinkAnimation "off"}
			{DefaultWeapon "hotchkiss"}			
			{Mounted}
			{weapon {ammo "ammo mgun" 150}}
		}			  
	}		
	
	{extender "inventory"
		{weapon "gun" {fixed}}
		{weapon "mgun" {fixed}{mask "weapon mgun"}}
		{weapon "mgun2" {fixed}{mask "weapon mgun"}}
		{weapon "mgun3" {fixed}{mask "weapon mgun"}}
		{weapon "mgun4" {fixed}{mask "weapon mgun"}}
		{box
			{item "ammo mgun" 600}
			{item "ammo bullet47 ap" 42}
			{item "ammo bullet47 fg" 78}
			{item "ammo bullet75 fg" 30}
		}
	}
        {Chassis
           	{speed
		  	{Slow	5}
		  	{Normal	8}
		  	{Fast	13}
	     	}
        	{FuelBag
          		{volume 336 }	; liters
	    		{rate   426 }   	; liters per kilometer
	    		{remain 336 }
          		{fuel "fuel"}
        	}

        }	
	
	{mass 69000}
	{Chassis
		{track_size 0.6 0.7}
		{Locomotion 
			{MaxSpeed 	    13} ; максимальная скорость, kmph
			{StartTime 		 7} ; время разгона до макс. скорости с 0, seconds
			{BrakeTime 		1} ; время торможения с макс. скорости до 0, seconds
			{StopTime		 1} ; время остановки после отключения двигателя с макс. скорости до 0, seconds
			{TurnRadius     20} ; мин. радиус разворота, meter
			{TurnTime		12} ; время на разворот на 360 градусов при макс. скорости разворота, seconds
			{TurnStart		 4}	; время разгона до макс. угловой скорости с 0, seconds
			{TurnStop	   2}	; время остановки с макс. угловой скорости до 0, seconds
			{Gears 0.2 0.3 0.5 0.7 1.0} ; передаточные коэф-ты коробки передач
			{RearGears 0.2 0.5} ; передаточные коэф-ты коробки передач
		}
	}	
	
	{Extension "fcm2c.mdl"}	
}
