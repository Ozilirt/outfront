			{weapon {ammo "ammo mgun" 60}}
		}
		{place "mgun4"
			{foresight "foresight4"}			
			{DefaultWeapon "dt"}
			{Mounted}
			{weapon {ammo "ammo mgun" 60}}
		}
	}
	{extender "inventory"
		{weapon "gun" {fixed}}		
		{box
			{item "ammo bullet76 fg" 27}	
			{item "ammo bullet76 ap" 35}	
