{
	(include "/properties/tank_multiturret.ext")
	(include "/properties/shadow/tank.inc"  scale(1.3))
	(include "/properties/selection/vehicle.inc"  scale(1.2))
	{props "medium"}
		
	{volume "body1"
		{tags "body"}
		{component "body"}
		{thickness 40}   
	}
	{volume "body2"
		{tags "body"}
		{component "body"}
		{thickness 40}   
	}
	{volume "body3"
		{tags "body"}
		{component "body"}
		{thickness 40}   
	}
	{volume "body4"
		{tags "body"}
		{component "body"}
		{thickness 40}   
	}


	{volume "turret"
		{thickness 30 0.3}
	}

	{volume "turret2"
		{tags "turret2"}
		{component "turret2"}
		{thickness 30}   
	}
	{volume "turret3"
		{tags "turret3"}
		{component "turret3"}
		{thickness 30}   
	}
	
	("crew_4_human")

	{boarder
		{anm "left"
			{forward	{begin	"board_cromwell"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "right"
			{forward	{begin	"board_cromwell"}}
			{reverse 	{end	"emit_tank_1_hold"}}
		}
		{anm "armor"
			{forward	{begin	"board_MiddleArmor"} 	{end "seat_armor"}}
			{reverse 	{end	"emit_tank_1"}}
		}
	}

	("seat_human" place(seat1) bone(seat01) door(emit3)  animation(armor))
	("seat_human" place(seat2) bone(seat02) door(emit4)  animation(armor))
	("seat_human" place(seat3) bone(seat03) door(emit5)  animation(armor))
	("seat_human" place(seat4) bone(seat04) door(emit6)  animation(armor))


	{Weaponry
		{place "gun"
			{DefaultWeapon "45mm_kt28"}
			{Mounted}
			{weapon {ammo "ammo bullet45 ap" 1}}
		}
		{place "mgun"
			{DefaultWeapon "dt"}
			{Mounted}
			{weapon {ammo "ammo mgun" 60}}
		}
		{place "mgun2"
			{foresight "foresight2"}
			{DefaultWeapon "dt"}
			{Mounted}
			{weapon {ammo "ammo mgun" 60}}
		}
		{place "mgun3"
			{foresight "foresight4"}
			{DefaultWeapon "dt"}
			{Mounted}
			{weapon {ammo "ammo mgun" 60}}
		}
	}
	{extender "inventory"
		{weapon "gun" {fixed}}
		{box
			{item  "ammo mgun" 650}
			{item "ammo bullet45 ap" 50}
			{item "ammo bullet45 fg" 27}
		}
	}
	
	{mass 20500}
	{Chassis
		{track_size 0.6 0.7}
		{Locomotion 
			{MaxSpeed 	    23} ; максимальная скорость, kmph
			{StartTime 		 7} ; время разгона до макс. скорости с 0, seconds
			{BrakeTime 		1} ; время торможения с макс. скорости до 0, seconds
			{StopTime		 1} ; время остановки после отключения двигателя с макс. скорости до 0, seconds
			{TurnRadius     5} ; мин. радиус разворота, meter
			{TurnTime		5} ; время на разворот на 360 градусов при макс. скорости разворота, seconds
			{TurnStart		 2}	; время разгона до макс. угловой скорости с 0, seconds
			{TurnStop	   0.5}	; время остановки с макс. угловой скорости до 0, seconds
			{Gears 0.2 0.3 0.5 0.7 1.0} ; передаточные коэф-ты коробки передач
			{RearGears 0.2 0.5} ; передаточные коэф-ты коробки передач
		}
	}
	{Extension "t-28.mdl"}

	(mod "mp"
		{sensor
			{visor "main"
				{vision "pz3g-main-mp"}
				{bone "visor1"}
			}
			{Visor "driver"
				{vision "pz3g-driver-mp"}
				{bone "visor2"}
			}
		}
	)
}
