{entity
 	(include "/properties/stuff_small.ext")
	{props "collectable" "physics_damping" "melee"}
	{mass 3}

	{simulation {able 1} {disableLinked 1}}
	{colliderID "stuff"}
	{collideWith "vehicle" "armored" "tank" "construction" "tree" "human"}
	{noCollideForStable}
	{noContactsAtAll 0}
	{rejectColliderByVolume}

	{extender "stuff"
		{item "szabla"}
	}

	{extension "szabla.mdl"}

}